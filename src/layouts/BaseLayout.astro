---
import Navigation from "../components/Navigation.astro";
import Chatbot from "../components/Chatbot.astro";
import "../styles/global.css";

interface Props {
  title: string;
  hero?: boolean;
}

const { title, hero = false } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Glowlink</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <Navigation />
    <main class:list={[
      hero
        ? "w-full min-w-0"
        : "mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12",
    ]}>
      {!hero && (
        <h1 class="text-3xl font-bold tracking-tight text-emerald-dark sm:text-4xl">{title}</h1>
      )}
      <slot />
    </main>
    <slot name="overlay" />
    <Chatbot />
  </body>
</html>
