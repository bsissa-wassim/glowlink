---
import Navigation from "../components/Navigation.astro";
import Chatbot from "../components/Chatbot.astro";
import "../styles/global.css";
import { getLanguage } from "../lib/i18n";

interface Props {
  title: string;
  hero?: boolean;
  lang?: "fr" | "en";
}

const { title, hero = false, lang = getLanguage(Astro) } = Astro.props;
if (Astro.cookies.get("glowlink-lang")?.value !== lang) {
  Astro.cookies.set("glowlink-lang", lang, { path: "/", sameSite: "lax", secure: Astro.url.protocol === "https:", httpOnly: true, maxAge: 60 * 60 * 24 * 365 });
}
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} | Glowlink</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <Navigation lang={lang}><slot name="navigation" /></Navigation>
    <main class:list={[
      hero
        ? "w-full min-w-0"
        : "mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12",
    ]}>
      {!hero && (
        <h1 class="text-3xl font-bold tracking-tight text-emerald-dark sm:text-4xl">{title}</h1>
      )}
      <slot />
    </main>
    <slot name="overlay" />
    <Chatbot />
  </body>
</html>
