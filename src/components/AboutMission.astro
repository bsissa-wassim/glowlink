---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import CareIcon from "./CareIcon.astro";
import { getHomepageContent } from "../data/homepageContent";
import { getLanguage, createTranslator, localizedHref } from "../lib/i18n";

const lang = getLanguage(Astro);
const t = createTranslator(lang);
const homepageContent = getHomepageContent(lang);

interface Props { portrait?: ImageMetadata; }
const { portrait } = Astro.props;
const { about, mission } = homepageContent;
const chapterEntrances = ["slide-left", "slide-right", "fade-up-scale"] as const;
const chapterIcons = ["globe", "clinic", "leaf"] as const;
const chapters = about.career.map((chapter, index) => {
  const separator = chapter.indexOf(" : ");
  return {
    title: chapter.slice(0, separator + 2).replace(/^\d+\s*\/\s*/, ""),
    description: chapter.slice(separator + 3),
    icon: chapterIcons[index],
    entrance: chapterEntrances[index],
  };
});
---

<section id="a-propos" data-reveal-children data-stagger-reveal data-reveal-stagger="120" aria-labelledby="about-heading mission-heading" class="scroll-mt-8 py-14 sm:py-20">
  <div class="mx-auto grid max-w-[120rem] gap-[38px] px-4 sm:px-6 md:grid-cols-2 lg:px-8">
    <article data-reveal-item data-reveal-effect="slide-left" aria-labelledby="about-heading" class="about-card relative isolate flex h-full min-w-0 flex-col overflow-hidden rounded-[20px] bg-sky text-midnight">
      <div class="flex items-center justify-between gap-6">
        <p class="text-xs font-medium tracking-[0.16em] sm:text-sm">{about.label}</p>
        <span class="about-icon flex shrink-0 items-center justify-center rounded-3xl bg-midnight text-white">
          <CareIcon name="conversation" class="size-10 xl:size-12 2xl:size-16" />
        </span>
      </div>
      <h2 id="about-heading" class="mt-7 text-3xl leading-[1.16] tracking-tight sm:text-4xl 2xl:text-5xl">{about.title}</h2>
      <div class="about-copy mt-7 border-t pt-7 text-lg leading-relaxed sm:text-xl">
        <p>{about.description}</p>
      </div>
      <a href={localizedHref("/la-fondatrice", lang)} class="mt-auto inline-flex min-h-11 items-center gap-3 self-start pt-8 text-lg font-semibold text-emerald hover:underline">{t("Rencontrer la fondatrice", "Meet the founder")} <span aria-hidden="true">→</span></a>
    </article>
    <article id="mission" data-reveal-item data-reveal-effect="slide-right" aria-labelledby="mission-heading" class="about-card relative isolate flex h-full min-w-0 scroll-mt-8 flex-col overflow-hidden rounded-[20px] bg-emerald text-white">
      <div class="flex items-center justify-between gap-6">
        <p class="text-xs font-medium tracking-[0.16em] sm:text-sm">{mission.label}</p>
        <span class="about-icon flex shrink-0 items-center justify-center rounded-3xl bg-white text-emerald">
          <CareIcon name="leaf" class="size-10 xl:size-12 2xl:size-16" />
        </span>
      </div>
      <h2 id="mission-heading" class="mt-7 text-3xl leading-[1.16] tracking-tight sm:text-4xl 2xl:text-5xl">{mission.title}</h2>
      <div class="about-copy mt-7 space-y-5 border-t pt-7 text-lg leading-relaxed sm:text-xl">
        {mission.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </article>
  </div>
  <div id="fondatrice" class="mx-auto mt-14 max-w-[120rem] scroll-mt-8 px-4 sm:mt-20 sm:px-6 lg:px-8">
    <header class="flex flex-col items-center gap-5 text-center sm:gap-8">
      {portrait && (
        <Picture
          src={portrait}
          alt={t("Portrait de Cheima Kochbati", "Portrait of Cheima Kochbati")}
          formats={["avif"]}
          fallbackFormat="webp"
          width={256}
          height={256}
          widths={[96, 128, 192, 256]}
          sizes="(min-width: 640px) 128px, 96px"
          quality={75}
          fit="cover"
          position="top"
          loading="lazy"
          decoding="async"
          pictureAttributes={{ class: "block shrink-0" }}
          class="block size-24 rounded-full border border-mint object-cover object-top sm:size-32"
        />
      )}
      <p id="founder-intro" class="max-w-4xl text-lg leading-relaxed text-midnight/90 sm:text-xl">{about.founder}</p>
      <a href={localizedHref("/la-fondatrice", lang)} class="inline-flex min-h-11 items-center gap-3 rounded-full bg-emerald px-6 py-3 text-white hover:bg-midnight motion-safe:transition-colors">{t("Découvrir la fondatrice", "Discover the founder")} <span aria-hidden="true">→</span></a>
    </header>
    <ol data-stagger-reveal data-reveal-stagger="2000" aria-labelledby="founder-intro" class="mx-auto mt-8 max-w-5xl space-y-6 px-2 pb-4">
      {chapters.map(({ title, description, icon, entrance }) => (
        <li data-reveal-item data-reveal-effect={entrance} class="founder-chapter">
          <div class="founder-paper-stack">
          <article class="founder-paper-card flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
            <span class="about-icon flex shrink-0 items-center justify-center rounded-3xl bg-mint/50 text-emerald">
              <CareIcon name={icon} class="size-7 sm:size-8" />
            </span>
            <div class="grid min-w-0 flex-1 gap-3 lg:grid-cols-[0.85fr_1.4fr] lg:items-center lg:gap-6">
              <h3 class="text-lg leading-snug font-bold tracking-tight text-midnight sm:text-xl">{title}</h3>
              <p class="max-w-prose text-base leading-relaxed text-midnight/90 sm:text-lg">{description}</p>
            </div>
          </article>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .about-card {
    --section-reveal-duration: 700ms;
    min-height: clamp(32rem, 38vw, 42rem);
    padding: clamp(1.5rem, 2.2vw, 3rem);
  }

  .about-icon {
    width: clamp(5rem, 8vw, 8.75rem);
    height: clamp(5rem, 8vw, 8.75rem);
  }

  .about-copy {
    border-color: color-mix(in srgb, currentColor 20%, transparent);
  }

  .about-card::before,
  .about-card::after {
    content: "";
    position: absolute;
    z-index: -1;
    bottom: -30%;
    right: -15%;
    width: 110%;
    height: 65%;
    border-radius: 60% 40% 55% 45% / 45% 65% 35% 55%;
    background: var(--color-white);
    opacity: 0.12;
    transform: rotate(-18deg);
    pointer-events: none;
  }

  .about-card::after {
    bottom: -38%;
    right: 10%;
    transform: rotate(20deg);
  }

  @media (max-width: 47.999rem) {
    .about-card {
      min-height: 29rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .about-card[data-section-reveal="visible"] {
      transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  .founder-chapter {
    --section-reveal-duration: 1600ms;
  }

  .founder-paper-stack {
    position: relative;
    isolation: isolate;
  }

  .founder-paper-stack::before,
  .founder-paper-stack::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid rgb(5 112 85 / 0.13);
    border-radius: 20px;
    pointer-events: none;
  }

  .founder-paper-stack::before {
    z-index: -2;
    background: color-mix(in srgb, var(--color-sage) 20%, var(--color-white));
    transform: translate(7px, 9px) rotate(0.45deg);
    box-shadow: 0 4px 12px rgb(18 42 69 / 0.06);
  }

  .founder-paper-stack::after {
    z-index: -1;
    background: color-mix(in srgb, var(--color-sky) 15%, var(--color-white));
    transform: translate(3px, 4px) rotate(-0.25deg);
  }

  .founder-paper-card {
    position: relative;
    padding: clamp(1rem, 1.5vw, 1.5rem);
    border: 1px solid rgb(5 112 85 / 0.15);
    border-radius: 20px;
    background: linear-gradient(145deg, var(--color-white) 0%, var(--color-white) 74%, color-mix(in srgb, var(--color-sage) 10%, var(--color-white)) 100%);
    box-shadow: 0 2px 4px rgb(18 42 69 / 0.05), 0 12px 28px rgb(18 42 69 / 0.08);
  }

  .founder-paper-card .about-icon {
    width: clamp(3.5rem, 5vw, 4.5rem);
    height: clamp(3.5rem, 5vw, 4.5rem);
  }

  .founder-chapter[data-reveal-effect="slide-left"] {
    --reveal-x: -64px;
  }

  .founder-chapter[data-reveal-effect="slide-right"] {
    --reveal-x: 64px;
  }

  .founder-chapter[data-reveal-effect="fade-up-scale"] {
    --reveal-y: 36px;
    --reveal-scale: 0.94;
  }
</style>
