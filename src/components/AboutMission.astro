---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import CareIcon from "./CareIcon.astro";
import { homepageContent } from "../data/homepageContent";

interface Props { portrait?: ImageMetadata; }
const { portrait } = Astro.props;
const { about, mission } = homepageContent;
---

<section id="a-propos" aria-labelledby="about-heading mission-heading" class="mx-auto max-w-5xl scroll-mt-8 px-4 py-12 sm:px-6 sm:py-16">
  <table role="table" aria-labelledby="about-heading mission-heading" class="w-full border-separate border-spacing-0 md:border-spacing-x-1">
    <tbody role="rowgroup" class="block md:table-row-group">
      <tr role="row" class="grid gap-2 md:table-row">
        <td role="cell" class="block bg-mint/30 p-6 align-top sm:p-9 md:table-cell md:w-1/2">
          <p class="flex items-center gap-3 text-xs font-medium tracking-[0.16em] text-emerald">
            <CareIcon name="conversation" class="size-5 shrink-0" />
            {about.label}
          </p>
          <h2 id="about-heading" class="mt-5 font-editorial text-3xl leading-[1.16] tracking-tight text-emerald-dark sm:text-4xl">{about.title}</h2>
          <p class="mt-5 text-sm leading-relaxed text-midnight/90">{about.description}</p>
          <div id="fondatrice" class="mt-6 scroll-mt-8">
            {portrait && (
              <Picture
                src={portrait}
                alt="Portrait de Cheima Kochbati"
                formats={["avif"]}
                fallbackFormat="webp"
                width={160}
                height={160}
                widths={[64, 80, 128, 160]}
                sizes="(min-width: 640px) 80px, 64px"
                quality={75}
                fit="cover"
                position="top"
                loading="lazy"
                decoding="async"
                pictureAttributes={{ class: "mb-4 block" }}
                class="block size-16 rounded-full border border-mint object-cover object-top sm:size-20"
              />
            )}
            <p class="text-sm leading-relaxed text-midnight/90">{about.founder}</p>
            <ol class="mt-5 space-y-5 text-sm leading-relaxed text-midnight/90">
              {about.career.map((chapter) => <li>{chapter}</li>)}
            </ol>
          </div>
        </td>
        <td id="mission" role="cell" class="block scroll-mt-8 bg-emerald-dark p-6 align-top text-white sm:p-9 md:table-cell md:w-1/2">
          <div class="flex items-center justify-between gap-4">
            <p class="text-xs font-medium tracking-[0.16em] text-mint">{mission.label}</p>
            <CareIcon name="leaf" class="size-7 shrink-0 text-mint" />
          </div>
          <h2 id="mission-heading" class="mt-5 font-editorial text-3xl leading-[1.16] tracking-tight sm:text-4xl">{mission.title}</h2>
          {mission.paragraphs.map((paragraph) => <p class="mt-5 text-sm leading-relaxed">{paragraph}</p>)}
        </td>
      </tr>
    </tbody>
  </table>
</section>
