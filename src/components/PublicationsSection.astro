---
import SectionHeading from "./SectionHeading.astro";
import { homepageContent } from "../data/homepageContent";

const content = homepageContent.publications;
---

<section id="publications" aria-labelledby="publications-heading" class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-20">
  <SectionHeading id="publications-heading" title={content.title} />
  <ul class="mt-7 divide-y divide-mint">
    {content.titles.map((title) => (
      <li class="py-6 sm:py-8">
        <h3 class="max-w-2xl font-sans text-2xl leading-snug tracking-tight text-emerald-dark sm:text-3xl">{title}</h3>
      </li>
    ))}
  </ul>
</section>
