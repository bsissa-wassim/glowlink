---
import { Picture } from "astro:assets";
import CareIcon from "./CareIcon.astro";
import SectionHeading from "./SectionHeading.astro";
import aestheticBackground from "../assets/specialties/esthetique.jpg";
import dentalBackground from "../assets/specialties/dentaire.jpg";
import eyeBackground from "../assets/specialties/ophtalmologie.jpg";
import { homepageContent } from "../data/homepageContent";

// Photos / Pexels license: https://www.pexels.com/license/
const backgrounds = [
  { src: aestheticBackground, position: "38% 45%", credit: "Anna Shvets", source: "https://www.pexels.com/photo/a-woman-consulting-with-a-cosmetologist-doctor-4586740/" },
  { src: dentalBackground, position: "65% 40%", credit: "Gustavo Fring", source: "https://www.pexels.com/photo/dentist-treating-womans-teeth-5622010/" },
  { src: eyeBackground, position: "50% 35%", credit: "Ksenia Chernaya", source: "https://www.pexels.com/photo/woman-examining-vision-with-microscope-5752299/" },
] as const;

const specialties = [
  { id: "chirurgie-esthetique", icon: "face" },
  { id: "soins-dentaires", icon: "tooth" },
  { id: "ophtalmologie", icon: "eye" },
] as const;
---

<section id="specialites" aria-labelledby="specialties-heading" class="specialties-section relative isolate overflow-hidden bg-mint/20">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden opacity-[0.20]">
    <div class="specialties-background-track">
      {[...backgrounds, backgrounds[0]].map(({ src, position }) => (
        <div class="specialties-background-frame">
          <Picture
            src={src}
            alt=""
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[640, 1024, 1600]}
            sizes="100vw"
            quality={70}
            loading="lazy"
            decoding="async"
            pictureAttributes={{ class: "block size-full" }}
            class="block size-full object-cover"
            style={`object-position: ${position}`}
          />
        </div>
      ))}
    </div>
  </div>
  <div class="relative mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
    <SectionHeading id="specialties-heading" title={homepageContent.specialties.title} />
    <table aria-labelledby="specialties-heading" class="mt-9 w-full border-collapse text-left">
      <thead>
        <tr>
          <th scope="col" class="pb-4 text-sm font-medium text-emerald-dark">{homepageContent.specialties.header}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-emerald/10">
        {specialties.map(({ id, icon }, index) => (
          <tr id={id} class="scroll-mt-8">
            <td class="py-5">
              <div class="flex items-center gap-4">
                <CareIcon name={icon} class="size-8 shrink-0 text-emerald" />
                <span class="text-lg leading-snug font-medium tracking-tight text-emerald-dark">{homepageContent.specialties.rows[index]}</span>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .specialties-background-track {
    display: flex;
    width: 400%;
    height: 100%;
    transform: translate3d(0, 0, 0);
  }

  .specialties-background-frame {
    flex: 0 0 25%;
    min-width: 0;
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .specialties-background-track {
      animation: specialties-background-scroll 18s cubic-bezier(0.45, 0, 0.2, 1) infinite;
    }

    .specialties-section:hover .specialties-background-track,
    .specialties-section:focus-within .specialties-background-track {
      animation-play-state: paused;
    }

    @keyframes specialties-background-scroll {
      0%, 25% { transform: translate3d(0, 0, 0); }
      33.3333%, 58.3333% { transform: translate3d(-25%, 0, 0); }
      66.6667%, 91.6667% { transform: translate3d(-50%, 0, 0); }
      100% { transform: translate3d(-75%, 0, 0); }
    }
  }
</style>
