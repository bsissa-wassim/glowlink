---
import { Picture } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import aestheticBackground from "../assets/specialties/esthetique.jpg";
import dentalBackground from "../assets/specialties/dentaire.jpg";
import eyeBackground from "../assets/specialties/ophtalmologie.jpg";
import { getHomepageContent } from "../data/homepageContent";
import { getLanguage } from "../lib/i18n";

const lang = getLanguage(Astro);
const homepageContent = getHomepageContent(lang);

// Photos / Pexels license: https://www.pexels.com/license/
const specialties = [
  { id: "chirurgie-esthetique", src: aestheticBackground, position: "38% 45%", credit: "Anna Shvets", source: "https://www.pexels.com/photo/a-woman-consulting-with-a-cosmetologist-doctor-4586740/" },
  { id: "soins-dentaires", src: dentalBackground, position: "65% 40%", credit: "Gustavo Fring", source: "https://www.pexels.com/photo/dentist-treating-womans-teeth-5622010/" },
  { id: "ophtalmologie", src: eyeBackground, position: "50% 35%", credit: "Ksenia Chernaya", source: "https://www.pexels.com/photo/woman-examining-vision-with-microscope-5752299/" },
] as const;
const photoSizes = "(min-width: 1920px) 611px, (min-width: 1024px) calc((100vw - 88px) / 3), (min-width: 768px) calc((100vw - 60px) / 2), calc(100vw - 32px)";
---

<section id="specialites" data-reveal-children data-stagger-reveal data-reveal-stagger="140" aria-labelledby="specialties-heading" class="bg-white py-14 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <SectionHeading id="specialties-heading" title={homepageContent.specialties.title} centered />
      <p id="specialties-categories" class="mt-8 text-center text-lg font-medium text-emerald-dark sm:text-xl">{homepageContent.specialties.header}</p>
    </div>
    <div aria-hidden="true" class="mx-auto mt-8 h-[2px] w-1/2 max-w-4xl bg-midnight"></div>
    <ul aria-labelledby="specialties-heading specialties-categories" class="mx-auto mt-10 grid max-w-[120rem] gap-3 px-4 sm:px-6 md:grid-cols-2 lg:grid-cols-3 lg:px-8">
      {specialties.map(({ id, src, position, credit, source }, index) => (
        <li id={id} data-reveal-item data-reveal-effect="scale" tabindex="0" aria-labelledby={`${id}-heading`} class="specialty-card relative isolate aspect-[3/4] min-w-0 scroll-mt-8 overflow-hidden bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-midnight">
          <Picture
            src={src}
            alt=""
            formats={["avif"]}
            fallbackFormat="webp"
            width={960}
            widths={[360, 540, 720, 960, 1280]}
            sizes={photoSizes}
            quality={75}
            loading="lazy"
            decoding="async"
            pictureAttributes={{ class: "absolute inset-0 block size-full" }}
            class="specialty-photo block size-full object-cover"
            style={`object-position: ${position}`}
            data-photo-credit={credit}
            data-photo-source={source}
          />
          <div class="specialty-overlay pointer-events-none absolute inset-0" aria-hidden="true"></div>
          <h3 id={`${id}-heading`} class="specialty-label pointer-events-none absolute inset-0 flex items-center justify-center px-6 text-center text-2xl leading-relaxed font-medium tracking-[0.08em] text-white uppercase sm:text-3xl xl:px-8 2xl:text-4xl">{homepageContent.specialties.rows[index]}</h3>
        </li>
      ))}
    </ul>
</section>

<style>
  .specialty-overlay {
    background: color-mix(in srgb, var(--color-midnight) 68%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {
    .specialty-overlay,
    .specialty-label {
      opacity: 0;
    }

    .specialty-card:hover .specialty-overlay,
    .specialty-card:hover .specialty-label,
    .specialty-card:focus .specialty-overlay,
    .specialty-card:focus .specialty-label {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .specialty-overlay,
    .specialty-label {
      transition: opacity 300ms ease;
    }
  }
</style>
