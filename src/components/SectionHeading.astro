---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<header class="max-w-3xl">
  <p class="mb-4 text-xs font-medium tracking-[0.16em] text-emerald uppercase">{eyebrow}</p>
  <h2 id={id} class="font-editorial text-4xl leading-[1.12] tracking-tight text-emerald-dark sm:text-5xl">
    {title}
  </h2>
  {Astro.slots.has("default") && (
    <div class="mt-5 max-w-xl text-sm leading-relaxed text-midnight/90 sm:text-base">
      <slot />
    </div>
  )}
</header>
