---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  tone?: "emerald" | "midnight";
}

const { id, eyebrow, title, tone = "emerald" } = Astro.props;
---

<header class="max-w-3xl">
  {eyebrow && <p class="mb-4 text-xs font-medium tracking-[0.16em] text-emerald uppercase">{eyebrow}</p>}
  <h2 id={id} class:list={["font-sans text-4xl leading-[1.12] tracking-tight sm:text-5xl", tone === "midnight" ? "text-midnight" : "text-emerald-dark"]}>
    {title}
  </h2>
  {Astro.slots.has("default") && (
    <div class="mt-5 max-w-xl text-sm leading-relaxed text-midnight/90 sm:text-base">
      <slot />
    </div>
  )}
</header>
