---
import { Picture } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import CareIcon from "./CareIcon.astro";
import meditationBackground from "../assets/wellness/meditation.jpg";
import { homepageContent } from "../data/homepageContent";

// Photo: Los Muertos Crew / Pexels, https://www.pexels.com/photo/woman-meditating-outdoors-8391701/
// License: https://www.pexels.com/license/
const content = homepageContent.philosophy;
---

<section id="philosophie" aria-labelledby="philosophy-heading" class="relative isolate mt-8 overflow-hidden sm:mt-12 lg:mt-16">
  <div aria-hidden="true" class="philosophy-background pointer-events-none absolute inset-0 bg-mint/20">
    <Picture
      src={meditationBackground}
      alt=""
      formats={["avif"]}
      fallbackFormat="webp"
      width={1800}
      height={1202}
      widths={[640, 1024, 1440, 1800]}
      sizes="100vw"
      quality={70}
      loading="lazy"
      decoding="async"
      pictureAttributes={{ class: "absolute inset-0 block size-full opacity-[0.20]" }}
      class="block size-full object-cover object-[50%_45%]"
    />
  </div>
  <div class="relative mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-20">
    <SectionHeading id="philosophy-heading" title={content.title} />
    <table aria-labelledby="philosophy-heading" class="mt-8 w-full text-left">
      <tbody>
        <tr>
          <td>
            <h3 class="flex items-center gap-3 text-lg font-bold text-emerald-dark">
              <CareIcon name="brain" class="size-6 shrink-0 text-emerald" />
              {content.label}
            </h3>
            <p class="mt-4 max-w-prose text-sm leading-relaxed text-midnight/90 sm:text-base">{content.description}</p>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<style>
  .philosophy-background {
    mask-image: linear-gradient(to bottom, transparent, #000 clamp(4rem, 7vw, 7rem));
  }
</style>
