---
const contacts = [
  {
    label: "Téléphone",
    value: "+1 (514) 570-3037",
    href: "tel:+15145703037",
    icon: "phone",
    action: "Appeler",
  },
  {
    label: "E-mail",
    value: "info.glowlink@gmail.com",
    href: "mailto:info.glowlink@gmail.com",
    icon: "mail",
    action: "Écrire",
  },
] as const;
---

<section id="contact" aria-labelledby="contact-heading" class="grid w-full scroll-mt-6 overflow-hidden md:grid-cols-2">
  <div class="flex flex-col items-start justify-center bg-emerald px-5 py-10 text-white sm:px-8 md:py-12 lg:px-12 xl:px-16">
    <p class="text-xs font-medium tracking-[0.16em] text-mint uppercase">Glowlink</p>
    <h2 id="contact-heading" class="contact-heading mt-4 text-4xl leading-[1.1] tracking-tight sm:text-5xl">
      Nous contacter
    </h2>
    <p class="mt-4 text-sm leading-relaxed text-white">Par téléphone ou par e-mail.</p>
    <a
      href="mailto:info.glowlink@gmail.com"
      class="mt-7 inline-flex min-h-11 items-center gap-3 rounded-full bg-midnight px-5 py-3 text-sm font-medium text-white hover:bg-midnight/90 focus-visible:outline-white motion-safe:transition-colors"
    >
      Envoyer un message
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4">
        <path d="M5 12h14m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>

  <address class="flex min-w-0 flex-col justify-center bg-mint/20 px-5 py-6 not-italic sm:px-8 md:py-8 lg:px-12 xl:px-16">
    <ul>
      {contacts.map(({ label, value, href, icon, action }) => (
        <li>
          <a
            href={href}
            class="group flex min-w-0 items-start gap-3 py-6 text-emerald-dark hover:text-emerald motion-safe:transition-colors sm:gap-4"
          >
            <span class="flex size-10 shrink-0 items-center justify-center" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5">
                {icon === "phone" ? (
                  <path d="m7 3 3 5-2.5 2a14 14 0 0 0 6.5 6.5l2-2.5 5 3-.8 3.2a2 2 0 0 1-2.1 1.5A19 19 0 0 1 2.3 5.9 2 2 0 0 1 3.8 3.8L7 3Z" stroke-linecap="round" stroke-linejoin="round" />
                ) : (
                  <>
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 6 9 7 9-7" stroke-linecap="round" stroke-linejoin="round" />
                  </>
                )}
              </svg>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-xs font-medium tracking-[0.08em] text-emerald-dark/70 uppercase">{label}</span>
              <span class="mt-2 block text-base font-medium tracking-tight [overflow-wrap:anywhere] sm:text-xl">{value}</span>
              <span class="mt-3 inline-flex items-center gap-2 text-xs text-emerald-dark/80 group-hover:underline group-hover:underline-offset-4">
                {action}
                <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" class="size-3">
                  <path d="M4 12 12 4M4 4h8v8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </address>
</section>

<style>
  .contact-heading {
    font-family: "Palatino Linotype", "Book Antiqua", Palatino, Georgia, serif;
  }
</style>
