---
import SectionHeading from "./SectionHeading.astro";
import TunisiaGallery from "./TunisiaGallery.astro";
import { homepageContent } from "../data/homepageContent";

const content = homepageContent.network;
---

<section id="reseau-medical" aria-labelledby="network-heading" class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
  <SectionHeading id="network-heading" title={content.title} />
  <div role="region" aria-labelledby="network-heading" tabindex="0" class="mt-8 overflow-x-auto focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-midnight">
    <table aria-labelledby="network-heading" class="w-full min-w-[34rem] border-collapse text-left text-sm leading-relaxed">
      <thead class="bg-midnight text-white">
        <tr>
          {content.headers.map((header) => <th scope="col" class="px-4 py-4 align-top font-medium">{header}</th>)}
        </tr>
      </thead>
      <tbody class="divide-y divide-midnight/10">
        {content.rows.map(([pillar, commitment]) => (
          <tr>
            <th scope="row" class="w-1/3 px-4 py-5 align-top font-medium text-midnight">{pillar}</th>
            <td class="px-4 py-5 align-top text-midnight/90">{commitment}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <TunisiaGallery />
</section>
