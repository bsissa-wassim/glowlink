---
import SectionHeading from "./SectionHeading.astro";
import CareIcon from "./CareIcon.astro";
import TunisiaGallery from "./TunisiaGallery.astro";
import { getHomepageContent } from "../data/homepageContent";
import { getLanguage } from "../lib/i18n";

const lang = getLanguage(Astro);
const homepageContent = getHomepageContent(lang);

const content = homepageContent.network;
const icons = ["globe", "shield", "clinic"] as const;
const entrances = ["slide-left", "slide-up", "slide-right"] as const;
const tones = ["emerald", "midnight", "sky"] as const;
const destinations = ["#tunisie", "#contact", "#contact"] as const;
---

<section id="reseau-medical" data-reveal-children data-stagger-reveal data-reveal-stagger="0" aria-labelledby="network-heading" class="bg-white py-14 sm:py-20">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <SectionHeading id="network-heading" title={content.title} centered>
      <p>{content.subtitle}</p>
    </SectionHeading>
  </div>
  <ul class="mx-auto mt-10 grid max-w-[120rem] gap-[38px] px-4 sm:px-6 md:grid-cols-2 lg:grid-cols-3 lg:px-8">
    {content.rows.map(([title, description], index) => (
      <li data-reveal-item data-reveal-effect={entrances[index]} class="network-item min-w-0">
        <article aria-labelledby={`network-card-${index}`} class:list={["network-card relative isolate flex h-full flex-col overflow-hidden rounded-[20px]", `network-card--${tones[index]}`]}>
          <div class="relative pt-5 sm:pt-8">
            <h3 id={`network-card-${index}`} class="font-sans text-2xl leading-[1.2] tracking-tight xl:text-3xl 2xl:text-4xl">{title}</h3>
            <p class="mt-7 text-lg leading-relaxed sm:text-xl">{description}</p>
          </div>
          <hr class="network-divider relative mt-7 border-0 border-t" />
          <div class="relative mt-auto flex items-end justify-between gap-5 pt-12">
            <span class="network-icon flex shrink-0 items-center justify-center rounded-3xl">
              <CareIcon name={icons[index]} class="size-10 xl:size-12 2xl:size-16" />
            </span>
            <a href={destinations[index]} aria-label={title} class="network-cta mb-1 inline-flex size-12 items-center justify-center rounded-full focus-visible:outline-2 focus-visible:outline-offset-4">
              <svg aria-hidden="true" viewBox="0 0 40 24" width="40" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12h35m-8-8 8 8-8 8" />
              </svg>
            </a>
          </div>
        </article>
      </li>
    ))}
  </ul>
  <div data-reveal-item class="mx-auto max-w-5xl px-4 sm:px-6">
    <TunisiaGallery />
  </div>
</section>

<style>
  .network-item {
    --section-reveal-duration: 700ms;
  }

  .network-card {
    min-height: clamp(32rem, 38vw, 42rem);
    padding: clamp(1.5rem, 2.2vw, 3rem);
  }

  .network-card--emerald {
    background: var(--color-emerald);
    color: var(--color-white);
  }

  .network-card--midnight {
    background: var(--color-midnight);
    color: var(--color-white);
  }

  .network-card--sky {
    background: var(--color-sky);
    color: var(--color-midnight);
  }

  .network-card::before,
  .network-card::after {
    content: "";
    position: absolute;
    z-index: -1;
    bottom: -28%;
    left: 12%;
    width: 115%;
    height: 66%;
    border-radius: 48% 52% 24% 76% / 62% 50% 50% 38%;
    background: var(--color-white);
    opacity: 0.1;
    transform: rotate(-24deg);
    pointer-events: none;
  }

  .network-card::after {
    bottom: -34%;
    left: -15%;
    transform: rotate(24deg);
  }

  .network-card--midnight::before,
  .network-card--midnight::after {
    background: var(--color-sky);
    opacity: 0.035;
  }

  .network-card--sky::before,
  .network-card--sky::after {
    bottom: -16%;
    left: 15%;
    height: 46%;
    border-radius: 4rem;
    opacity: 0.22;
    transform: rotate(-30deg);
  }

  .network-card--sky::after {
    bottom: -8%;
    left: -28%;
  }

  .network-divider {
    border-color: currentColor;
    opacity: 0.2;
  }

  .network-icon {
    width: clamp(5rem, 8vw, 8.75rem);
    height: clamp(5rem, 8vw, 8.75rem);
    background: var(--color-midnight);
    color: var(--color-white);
  }

  .network-card--midnight .network-icon {
    background: var(--color-sky);
    color: var(--color-midnight);
  }

  .network-cta:focus-visible {
    outline-color: currentColor;
  }

  @media (max-width: 47.999rem) {
    .network-card {
      min-height: 29rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .network-item[data-reveal-effect="slide-up"] {
      --reveal-x: 0px;
      --reveal-y: 36px;
    }

    .network-item[data-section-reveal="visible"] {
      transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
  }
</style>
