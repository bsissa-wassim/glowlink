---
import SectionHeading from "./SectionHeading.astro";
import CareIcon from "./CareIcon.astro";
import TunisiaGallery from "./TunisiaGallery.astro";
import { homepageContent } from "../data/homepageContent";

const content = homepageContent.network;
const icons = ["globe", "shield", "clinic"] as const;
const entrances = ["slide-left", "slide-down", "slide-right"] as const;
---

<section id="reseau-medical" data-reveal-children data-stagger-reveal aria-labelledby="network-heading" class="mx-auto max-w-5xl bg-white px-4 py-14 sm:px-6 sm:py-20">
  <SectionHeading id="network-heading" title={content.title}>
    <p>{content.subtitle}</p>
  </SectionHeading>
  <ul class="mt-10 grid gap-5 md:grid-cols-3 md:gap-6">
    {content.rows.map(([title, description], index) => (
      <li data-reveal-item data-reveal-effect={entrances[index]} class="network-item min-w-0">
        <article aria-labelledby={`network-card-${index}`} class="network-card h-full p-6 sm:p-7">
          <span class="network-icon mb-6 flex size-12 items-center justify-center rounded-xl bg-mint/50 text-emerald">
            <CareIcon name={icons[index]} class="size-7" />
          </span>
          <h3 id={`network-card-${index}`} class="font-sans text-2xl leading-tight tracking-tight text-emerald-dark">{title}</h3>
          <p class="mt-4 text-sm leading-relaxed text-midnight/90">{description}</p>
        </article>
      </li>
    ))}
  </ul>
  <div data-reveal-item>
    <TunisiaGallery />
  </div>
</section>

<style>
  .network-card {
    border: 1px solid rgb(0 127 96 / 0.12);
    border-radius: 0.75rem;
    background: white;
    box-shadow: 0 4px 20px rgb(18 43 74 / 0.04);
  }

  @media (hover: hover) and (pointer: fine) {
    .network-item:hover .network-card {
      border-color: rgb(0 127 96 / 0.28);
      box-shadow: 0 14px 32px rgb(0 127 96 / 0.09), 0 0 0 1px rgb(0 127 96 / 0.06);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .network-card {
      transition: transform 280ms ease, border-color 280ms ease, box-shadow 280ms ease;
    }

    .network-icon {
      transition: transform 280ms ease;
    }

    @media (hover: hover) and (pointer: fine) {
      .network-item:hover .network-card {
        transform: translateY(-6px);
      }

      .network-item:hover .network-icon {
        transform: translateY(-2px) rotate(-4deg);
      }
    }
  }
</style>
