---
import { socialAccounts } from "../config/social";
---

<section aria-label="Retrouvez Glowlink sur les réseaux sociaux" tabindex="0" class="social-banner w-full text-white">
  <div class="social-content">
    <div class="social-copy">
      <h2>
        Suivez-nous sur{" "}
        <span class="social-platforms">
          {socialAccounts.map(({ id, label, url }, index) => {
            const Tag = url ? "a" : "span";

            return (
              <Tag
                href={url ?? undefined}
                target={url ? "_blank" : undefined}
                rel={url ? "noopener noreferrer" : undefined}
                style={`--platform-index: ${index}`}
                class="social-platform-name"
                data-platform={id}
              >
                {label}
              </Tag>
            );
          })}
        </span>
      </h2>
    </div>

    <div class="social-icon-stage" aria-hidden="true">
      <svg class="social-icon-echo" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round">
        <path d="M18 65a48 48 0 0 1 48-48M7 55A59 59 0 0 1 55 7M135 182a48 48 0 0 0 48-48M145 193a59 59 0 0 0 48-48" />
      </svg>
      {socialAccounts.map(({ id }, index) => (
        <span
          style={`--platform-index: ${index}; --social-icon: url("/social/${id}.svg")`}
          class:list={["social-platform-icon", { "social-platform-icon-facebook": id === "facebook" }]}
        ></span>
      ))}
    </div>
  </div>
</section>

<style>
  .social-banner {
    background: var(--color-midnight);
  }

  .social-banner:focus-visible {
    outline: 2px solid white;
    outline-offset: -4px;
  }

  .social-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    min-height: 18rem;
    max-width: 100rem;
    align-items: center;
    gap: clamp(1.25rem, 6vw, 8rem);
    margin-inline: auto;
    padding: clamp(2rem, 4vw, 4rem) clamp(1.25rem, 5vw, 5rem);
  }

  .social-copy {
    max-width: 56rem;
    font-size: clamp(1.25rem, 2vw, 2rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .social-copy h2 {
    margin: 0 0 1.25rem;
    font: inherit;
  }

  .social-copy p {
    margin: 0;
    text-wrap: pretty;
  }

  .social-platforms {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25em 0.5em;
    vertical-align: baseline;
  }

  .social-platform-name {
    white-space: nowrap;
  }

  a.social-platform-name:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  a.social-platform-name:focus-visible {
    outline: 2px solid white;
    outline-offset: 4px;
  }

  .social-icon-stage {
    position: relative;
    display: grid;
    width: clamp(5rem, 14vw, 12rem);
    aspect-ratio: 1;
  }

  .social-icon-echo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .social-platform-icon {
    width: 50%;
    height: 50%;
    grid-area: 1 / 1;
    place-self: center;
    background-color: currentColor;
    mask-image: var(--social-icon);
    mask-position: center;
    mask-size: contain;
    mask-repeat: no-repeat;
  }

  .social-platform-icon-facebook {
    width: 70%;
    height: 70%;
  }

  .social-banner:hover .social-platform-name,
  .social-banner:hover .social-platform-icon,
  .social-banner:focus-within .social-platform-name,
  .social-banner:focus-within .social-platform-icon {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: no-preference) {
    .social-platforms {
      display: inline-grid;
    }

    .social-platform-name {
      grid-area: 1 / 1;
    }

    .social-platform-name,
    .social-platform-icon {
      animation: social-platform-cycle 18s linear infinite;
      animation-delay: calc(var(--platform-index) * 6s - 18s);
    }

    @keyframes social-platform-cycle {
      0% {
        visibility: visible;
        opacity: 0;
        transform: translate3d(0, 6px, 0);
      }
      2%, 30% {
        visibility: visible;
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
      33.332% {
        visibility: visible;
        opacity: 0;
        transform: translate3d(0, -6px, 0);
      }
      33.333%, 100% {
        visibility: hidden;
        opacity: 0;
        transform: translate3d(0, 6px, 0);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-content {
      grid-template-columns: 1fr;
    }

    .social-platform-name:not(:last-child)::after {
      content: ",";
    }

    .social-icon-stage {
      display: none;
    }
  }
</style>
