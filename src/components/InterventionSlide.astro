---
import { consultationResources, type Intervention } from "../data/interventions";
import { interventionImageSrcSet, type InterventionPhoto } from "../data/interventionPhotos";

interface Props {
  intervention: Intervention;
  photo: InterventionPhoto;
  detailHref: string | null;
}

const { intervention, photo, detailHref } = Astro.props;
const Action = detailHref ? "a" : "button";
const coverage = Math.max(1, (photo.width / photo.height) / (3 / 4)) * (photo.zoom ?? 1);
const sizes = `(min-width: 1024px) ${(34 * coverage).toFixed(1)}vw, (min-width: 640px) ${(46 * coverage).toFixed(1)}vw, ${(82 * coverage).toFixed(1)}vw`;
const modalSizes = "(min-width: 800px) 768px, calc(100vw - 2rem)";
---

<li data-carousel-slide class="intervention-slide">
  <Action
    href={detailHref ?? undefined}
    type={detailHref ? undefined : "button"}
    data-intervention-action
    data-intervention-open={detailHref ? undefined : intervention.id}
    aria-label={`Découvrir ${intervention.name}`}
    aria-haspopup={detailHref ? undefined : "dialog"}
    aria-controls={detailHref ? undefined : "interventions-dialog"}
    class="slide-action"
  >
    <picture class="slide-picture">
      <source type="image/avif" srcset={interventionImageSrcSet(photo, "avif")} sizes={sizes} />
      <source type="image/webp" srcset={interventionImageSrcSet(photo, "webp")} sizes={sizes} />
      <img
        src={photo.src}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        loading="lazy"
        decoding="async"
        style={`object-position: ${photo.position}; --portrait-scale: ${photo.zoom ?? 1}`}
        class="slide-image"
      />
    </picture>
    <span class="slide-overlay" aria-hidden="true">
      <span class="slide-title">{intervention.name}</span>
    </span>
  </Action>

  {!detailHref && (
    <template data-intervention-template={intervention.id}>
      <figure class="aspect-video overflow-hidden" aria-hidden="true">
        <picture class="block size-full">
          <source type="image/avif" srcset={interventionImageSrcSet(photo, "avif")} sizes={modalSizes} />
          <source type="image/webp" srcset={interventionImageSrcSet(photo, "webp")} sizes={modalSizes} />
          <img src={photo.src} alt="" width={photo.width} height={photo.height} loading="lazy" decoding="async" class="block size-full object-cover" style={`object-position: ${photo.position}`} />
        </picture>
      </figure>
      <div class="p-6 sm:p-8">
        <p class="mb-3 text-xs font-medium tracking-[0.1em] text-emerald uppercase">{intervention.zone}</p>
        <h2 id="intervention-detail-title" data-detail-title tabindex="-1" class="detail-title text-3xl leading-tight tracking-tight text-emerald-dark outline-none sm:text-4xl">{intervention.name}</h2>
        <p class="mt-5 leading-relaxed text-midnight/90">{intervention.description}</p>
        <p class="mt-6 font-medium text-emerald-dark">À aborder en consultation</p>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-midnight/90">
          <li>Les objectifs et les options adaptés à votre situation.</li>
          <li>Les bénéfices attendus, les limites et les risques de l’intervention.</li>
          <li>{intervention.category === "reparatrice" ? "Les étapes du parcours et le suivi avec l’équipe spécialisée." : "Les suites, le suivi et l’organisation de votre séjour."}</li>
        </ul>
        <a href={`mailto:info.glowlink@gmail.com?subject=${encodeURIComponent(`Demande d’information : ${intervention.name}`)}`} class="mt-6 inline-flex min-h-11 items-center justify-center rounded-full bg-midnight px-5 py-3 text-sm font-medium text-white hover:bg-midnight/90">
          Échanger sur cette intervention
        </a>
        <p class="mt-5 text-xs leading-relaxed text-midnight/60">
          <a href={intervention.category === "reparatrice" ? consultationResources.reconstructive : consultationResources.cosmetic} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">
            {intervention.category === "reparatrice" ? "Informations sur les prises en charge spécialisées" : "Préparer une consultation"} · NHS, en anglais
            <span class="sr-only"> (nouvel onglet)</span>
          </a>
        </p>
      </div>
    </template>
  )}
</li>

<style>
  .intervention-slide {
    min-width: 0;
    scroll-snap-align: start;
  }

  .slide-action {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    padding: 0;
    border: 0;
    background: var(--color-mint);
    cursor: pointer;
    color: white;
    text-decoration: none;
  }

  .slide-picture,
  .slide-image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .slide-image {
    object-fit: cover;
    transform: scale(var(--portrait-scale, 1));
    transform-origin: center bottom;
  }

  .slide-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 3vw, 3rem);
    background: rgb(0 0 0 / 0.55);
    text-align: center;
  }

  .slide-title,
  .detail-title {
    font-family: "Palatino Linotype", "Book Antiqua", Palatino, Georgia, serif;
  }

  .slide-title {
    max-width: 20ch;
    font-size: clamp(1.25rem, 2vw, 2rem);
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .slide-action:focus-visible {
    outline: 2px solid white;
    outline-offset: -6px;
  }

  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) {
    .slide-overlay {
      opacity: 0;
    }

    .slide-action:hover .slide-overlay,
    .slide-action:focus-visible .slide-overlay {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .slide-image,
    .slide-overlay {
      transition: transform 350ms ease, opacity 350ms ease;
    }

    @media (hover: hover) and (pointer: fine) {
      .slide-action:hover .slide-image {
        transform: scale(calc(var(--portrait-scale, 1) * 1.03));
      }
    }
  }
</style>
