---
import CareIcon from "./CareIcon.astro";
import SectionHeading from "./SectionHeading.astro";

const steps = [
  {
    icon: "conversation",
    timing: "Avant le voyage",
    title: "La préparation à distance",
    introduction: "Depuis le Canada, les États-Unis ou l’Europe, un accompagnement commence avant votre départ.",
    details: "Échanges personnalisés, audios apaisants sur WhatsApp, méditation guidée ou sophrologie : des ressources de détente sont proposées selon vos préférences, en complément des consignes de votre équipe médicale.",
  },
  {
    icon: "leaf",
    timing: "À votre arrivée à Tunis",
    title: "La Journée Sérénité",
    introduction: "Une parenthèse pour ralentir, prendre vos repères et vous installer sereinement.",
    details: "Une journée de détente peut être organisée 24 à 48 heures avant l’intervention, selon votre planning médical : massages doux du cou, de la tête ou des jambes, ambiance apaisante et aromathérapie selon vos souhaits. Chaque prestation est adaptée et soumise à l’accord de l’équipe soignante.",
  },
  {
    icon: "gift",
    timing: "Après votre intervention",
    title: "Le réconfort et le suivi",
    introduction: "Des attentions personnelles et une coordination qui se poursuivent jusqu’à votre retour.",
    details: "Notre Glow Box réunit un plaid doux, des tisanes, un masque de nuit en soie et une lettre personnalisée. Ces attentions de confort s’accompagnent de l’organisation de vos rendez-vous de suivi ; les soins et leur calendrier restent définis par l’équipe médicale.",
  },
] as const;
---

<section id="parcours-patient" aria-labelledby="journey-heading" class="mx-auto max-w-5xl scroll-mt-8 px-4 py-12 sm:px-6 sm:py-20">
  <SectionHeading id="journey-heading" eyebrow="Pourquoi GlowLink" title="Un parcours pensé pour votre sérénité.">
    <p>Avant, pendant et après votre séjour : trois étapes pour avancer avec des repères et une présence à vos côtés.</p>
  </SectionHeading>

  <ol class="journey-timeline mt-10 grid gap-8 md:mt-12 md:grid-cols-3 md:gap-8">
    {steps.map(({ icon, timing, title, introduction, details }, index) => (
      <li class="relative min-w-0">
        <details name="patient-journey" open={index === 0} class="group">
          <summary class="journey-summary relative cursor-pointer list-none focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-emerald">
            <span class="relative z-10 mb-5 flex size-12 items-center justify-center bg-white text-emerald group-open:bg-emerald group-open:text-white motion-safe:transition-colors">
              <CareIcon name={icon} />
            </span>
            <span class="mb-3 block text-xs font-medium tracking-[0.06em] text-emerald uppercase">0{index + 1} / {timing}</span>
            <h3 class="flex items-start justify-between gap-3 text-xl font-medium tracking-tight text-emerald-dark">
              {title}
              <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" class="mt-1 size-4 shrink-0 group-open:rotate-180 motion-safe:transition-transform">
                <path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </h3>
            <span class="mt-3 block text-sm leading-relaxed text-midnight/90">{introduction}</span>
          </summary>
          <p class="mt-4 text-sm leading-relaxed text-midnight/90">{details}</p>
        </details>
      </li>
    ))}
  </ol>
  <a href="#contact" class="mt-9 inline-flex min-h-11 items-center gap-3 text-sm font-medium text-emerald-dark underline decoration-emerald/30 underline-offset-4 hover:decoration-emerald">
    Échanger sur mon parcours <span aria-hidden="true">↗</span>
  </a>
</section>

<style>
  .journey-summary::-webkit-details-marker { display: none; }

  @media (min-width: 48rem) {
    .journey-timeline { position: relative; }
    .journey-timeline::before {
      content: "";
      position: absolute;
      top: 1.5rem;
      right: 0;
      left: 0;
      height: 1px;
      background: var(--color-mint);
    }
  }
</style>
