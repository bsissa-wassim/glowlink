---
import CareIcon from "./CareIcon.astro";
import SectionHeading from "./SectionHeading.astro";
import { homepageContent } from "../data/homepageContent";

const content = homepageContent.journey;
---

<section id="parcours-patient" aria-labelledby="journey-heading" class="mx-auto max-w-5xl scroll-mt-8 px-4 py-12 sm:px-6 sm:py-20">
  <SectionHeading id="journey-heading" title={content.title} tone="midnight" />
  <ol class="journey-timeline mt-10 grid gap-8 md:mt-12 md:grid-cols-3 md:gap-8">
    {content.steps.map(({ icon, title, description }, index) => (
      <li class="relative min-w-0">
        <details name="patient-journey" open={index === 0} class="group">
          <summary class="journey-summary relative cursor-pointer list-none focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-midnight">
            <span class="relative z-10 mb-5 flex size-12 items-center justify-center bg-white text-emerald group-open:bg-midnight group-open:text-white motion-safe:transition-colors">
              <CareIcon name={icon} />
            </span>
            <h3 class="flex items-start justify-between gap-3 text-xl font-medium tracking-tight text-midnight">
              {title}
              <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" class="mt-1 size-4 shrink-0 group-open:rotate-180 motion-safe:transition-transform">
                <path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </h3>
          </summary>
          <p class="mt-4 text-sm leading-relaxed text-midnight/90">{description}</p>
        </details>
      </li>
    ))}
  </ol>
</section>

<style>
  .journey-summary::-webkit-details-marker { display: none; }
  @media (min-width: 48rem) {
    .journey-timeline { position: relative; }
    .journey-timeline::before {
      content: "";
      position: absolute;
      top: 1.5rem;
      right: 0;
      left: 0;
      height: 1px;
      background: var(--color-midnight);
      opacity: 0.18;
    }
  }
</style>
