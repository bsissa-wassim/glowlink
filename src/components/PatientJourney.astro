---
import CareIcon from "./CareIcon.astro";
import SectionHeading from "./SectionHeading.astro";
import { getHomepageContent } from "../data/homepageContent";
import { getLanguage } from "../lib/i18n";

const lang = getLanguage(Astro);
const homepageContent = getHomepageContent(lang);

const content = homepageContent.journey;
---

<section id="parcours-patient" data-reveal-children aria-labelledby="journey-heading" class="scroll-mt-8 py-14 sm:py-20">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <SectionHeading id="journey-heading" title={content.title} tone="midnight" centered />
  </div>
  <ol class="mx-auto mt-10 grid max-w-[120rem] gap-[38px] px-4 sm:px-6 md:grid-cols-2 lg:grid-cols-3 lg:px-8">
    {content.steps.map(({ icon, title, description }) => (
      <li data-journey-step class="relative min-w-0">
        <div class="journey-card relative isolate flex h-full flex-col overflow-hidden rounded-[20px]">
        <details open class="group">
          <summary class="journey-summary relative cursor-pointer list-none focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-current">
            <span class="journey-icon mb-8 flex items-center justify-center rounded-3xl">
              <CareIcon name={icon} class="size-10 xl:size-12 2xl:size-16" />
            </span>
            <h3 class="flex items-start justify-between gap-3 text-2xl leading-[1.2] font-bold tracking-tight xl:text-3xl 2xl:text-4xl">
              {title}
              <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" class="mt-1 size-4 shrink-0 group-open:rotate-180 motion-safe:transition-transform">
                <path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </h3>
          </summary>
          <p class="journey-description mt-7 border-t pt-7 text-lg leading-relaxed sm:text-xl">{description}</p>
        </details>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .journey-card {
    min-height: clamp(32rem, 38vw, 42rem);
    padding: clamp(1.5rem, 2.2vw, 3rem);
    background: var(--color-champagne);
    color: var(--color-midnight);
  }

  .journey-icon {
    width: clamp(5rem, 8vw, 8.75rem);
    height: clamp(5rem, 8vw, 8.75rem);
    background: var(--color-white);
    color: var(--color-midnight);
  }

  .journey-description {
    border-color: color-mix(in srgb, currentColor 20%, transparent);
  }

  .journey-card::before,
  .journey-card::after {
    content: "";
    position: absolute;
    z-index: -1;
    bottom: -22%;
    left: -30%;
    width: 140%;
    height: 56%;
    border-radius: 50% 50% 38% 62% / 65% 45% 55% 35%;
    background: var(--color-white);
    opacity: 0.12;
    transform: rotate(12deg);
    pointer-events: none;
  }

  .journey-card::after {
    bottom: -30%;
    left: 10%;
    transform: rotate(-18deg);
  }

  @media (max-width: 47.999rem) {
    .journey-card {
      min-height: 29rem;
    }
  }

  .journey-summary::-webkit-details-marker { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    [data-journey-reveal="pending"] {
      opacity: 0;
      transform: translate3d(-44px, 0, 0);
    }

    [data-journey-reveal="visible"] {
      opacity: 1;
      transform: none;
      transition: opacity 900ms ease-out, transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: var(--journey-reveal-delay, 0ms);
    }

    [data-journey-step]:focus-within {
      opacity: 1;
      transform: none;
      transition: none;
    }

  }
</style>

<script>
  const journey = document.querySelector<HTMLElement>("#parcours-patient");
  const steps = [...(journey?.querySelectorAll<HTMLElement>("[data-journey-step]") ?? [])];

  if (journey && steps.length && "IntersectionObserver" in window) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let observer: IntersectionObserver | null = null;
    let nextRevealAt = 0;
    // Allow each 900ms entrance to finish, followed by a 700ms settling pause.
    const sequenceInterval = 1600;

    const reveal = (step: HTMLElement, delay = 0) => {
      step.style.setProperty("--journey-reveal-delay", `${delay}ms`);
      step.dataset.journeyReveal = "visible";
      observer?.unobserve(step);
    };

    const update = () => {
      observer?.disconnect();
      nextRevealAt = 0;
      if (reducedMotion.matches) {
        steps.forEach((step) => step.removeAttribute("data-journey-reveal"));
        return;
      }

      observer = new IntersectionObserver((entries) => {
        const entering = entries
          .filter((entry) => entry.isIntersecting && (entry.target as HTMLElement).dataset.journeyReveal === "pending")
          .map((entry) => entry.target as HTMLElement)
          .sort((a, b) => steps.indexOf(a) - steps.indexOf(b));

        // Keep one sequence even when mobile steps enter in separate observer callbacks.
        entering.forEach((step) => {
          const now = performance.now();
          const startAt = Math.max(now, nextRevealAt);
          reveal(step, Math.round(startAt - now));
          nextRevealAt = startAt + sequenceInterval;
        });
      }, { threshold: 0.2, rootMargin: "0px 0px -48px 0px" });

      steps.forEach((step) => {
        if (step.dataset.journeyReveal === "visible") return;
        if (step.getBoundingClientRect().bottom < 0) {
          reveal(step);
        } else {
          step.dataset.journeyReveal = "pending";
          observer?.observe(step);
        }
      });
    };

    journey.addEventListener("focusin", (event) => {
      if (!(event.target instanceof Element)) return;
      const step = event.target.closest<HTMLElement>("[data-journey-step]");
      if (step) reveal(step);
    });

    update();
    reducedMotion.addEventListener("change", update);
  }
</script>
