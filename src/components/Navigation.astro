---
const links = [
  { label: "Accueil", href: "/", preview: [] },
  { label: "À propos", href: "/a-propos", preview: [{ label: "Présentation", href: "/#a-propos" }, { label: "Notre mission", href: "/#mission" }, { label: "La fondatrice", href: "/#fondatrice" }] },
  {
    label: "Interventions", href: "/#specialites",
    preview: [
      { label: "Chirurgie esthétique & plastique", href: "/#chirurgie-esthetique" },
      { label: "Soins & chirurgie dentaire", href: "/#soins-dentaires" },
      { label: "Ophtalmologie", href: "/#ophtalmologie" },
    ],
  },
  {
    label: "Publication", href: "/publication",
    preview: [
      { label: "Blog", href: "/blog" },
      { label: "Parcours patient", href: "/experience-centree-patient" },
    ],
  },
  { label: "Contact", href: "/#contact", preview: [] },
] as const;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header class="relative z-30 min-h-[var(--header-height)] bg-white">
  <div
    class="flex min-h-[var(--header-height)] w-full min-w-0 flex-col justify-center gap-2 px-4 py-2 md:px-6 lg:grid lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] lg:items-center lg:gap-0"
  >
    <span class="flex items-center justify-start gap-2 text-lg font-semibold tracking-tight text-emerald-dark lg:justify-self-start">
      <span aria-hidden="true" class="size-6 rounded-full border border-emerald"></span>
      Glowlink
    </span>

    <nav aria-label="Navigation principale" class="mx-auto w-full max-w-sm md:max-w-none lg:w-auto">
      <ul class="flex flex-wrap items-center justify-center lg:flex-nowrap lg:gap-1">
        {
          links.map(({ label, href, preview }) => {
            const isCurrentPage = currentPath === href;
            const isActive = isCurrentPage || (href === "/publication" && preview.some((item) => item.href === currentPath));

            return (
              <li class:list={[
                "relative flex items-center justify-center border-b-2",
                isActive ? "border-emerald" : "border-transparent",
              ]}>
                <a
                  href={currentPath === "/" && href.startsWith("/#") ? href.slice(1) : href}
                  aria-current={isCurrentPage ? "page" : undefined}
                  class:list={[
                    "flex min-h-11 items-center justify-center py-1.5 text-base font-medium motion-safe:transition-colors",
                    preview.length > 0 ? "pl-2 pr-1" : "px-3",
                    isActive
                      ? "text-emerald-dark"
                      : "text-midnight/70 hover:text-emerald",
                  ]}
                >
                  {label}
                </a>
                {preview.length > 0 && (
                  <details data-nav-submenu class="group">
                    <summary
                      aria-label={`Afficher le sous-menu ${label}`}
                      class="flex min-h-11 w-8 cursor-pointer list-none items-center justify-center text-emerald-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald [&::-webkit-details-marker]:hidden"
                    >
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 20 20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        class="size-4 group-open:rotate-180 motion-safe:transition-transform"
                      >
                        <path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </summary>
                    <div class:list={[
                      "absolute top-full z-10 mt-1 w-52 max-w-[calc(100vw-2rem)] rounded-xl border border-mint bg-white p-3 shadow-[0_8px_24px_#00664d12]",
                      href === "/a-propos" ? "right-0 md:left-0 md:right-auto" : "left-0",
                    ]}>
                      <p class="px-2 pb-2 text-xs text-emerald-dark/70">{href === "/#specialites" ? "Nos spécialités" : href === "/publication" ? "Nos publications" : "Découvrir GlowLink"}</p>
                      <ul aria-label={`Sous-menu ${label}`}>
                        {preview.map(({ label: itemLabel, href: itemHref }) => (
                          <li class="text-sm text-midnight/80">
                            <a href={currentPath === "/" && itemHref.startsWith("/#") ? itemHref.slice(1) : itemHref} aria-current={currentPath === itemHref ? "page" : undefined} class="flex min-h-11 items-center rounded-lg px-2 py-2 hover:bg-mint/50 hover:text-emerald-dark">{itemLabel}</a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </details>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const submenus = [...document.querySelectorAll<HTMLDetailsElement>("[data-nav-submenu]")];

  submenus.forEach((submenu) => {
    submenu.addEventListener("toggle", () => {
      if (submenu.open) {
        submenus.forEach((other) => {
          if (other !== submenu) other.open = false;
        });
      }
    });

    submenu.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !submenu.contains(event.relatedTarget)) {
        submenu.open = false;
      }
    });
  });

  document.addEventListener("click", (event) => {
    submenus.forEach((submenu) => {
      if (event.target instanceof Node && (!submenu.contains(event.target) || (event.target instanceof Element && event.target.closest("a")))) submenu.open = false;
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const submenu = submenus.find((item) => item.open);
    if (submenu) {
      submenu.open = false;
      submenu.querySelector("summary")?.focus();
    }
  });
</script>
