---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  portrait?: ImageMetadata;
  portraitAlt?: string;
}

const {
  portrait,
  portraitAlt = "Portrait de Cheima kochbati, fondatrice de GlowLink",
} = Astro.props;

const chapters = [
  {
    location: "Tunisie · Arabie saoudite · Dubaï",
    title: "La rigueur du soin",
    description: "J’ai débuté ma carrière à l’international comme infirmière anesthésiste. Ces environnements chirurgicaux exigeants m’ont transmis une solide culture de la sécurité des patients et de la rigueur clinique.",
  },
  {
    location: "Canada",
    title: "Une vision globale de la santé",
    description: "Au Canada, j’ai obtenu une maîtrise en gestion des services de santé, pour relier mon expérience clinique à une compréhension approfondie de la gouvernance, de l’organisation et de la coordination des parcours.",
  },
  {
    location: "Aujourd’hui · GlowLink",
    title: "Un engagement devenu GlowLink",
    description: "Avec GlowLink, je réunis mon expérience clinique internationale, ma formation canadienne en gestion et mon engagement humain pour accompagner l’organisation de votre parcours médical en Tunisie.",
  },
] as const;
---

<section id="fondatrice" aria-labelledby="founder-heading" class="mx-auto grid max-w-5xl items-start gap-10 bg-white px-4 py-12 sm:px-6 sm:py-20 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
  <header class="max-w-3xl lg:sticky lg:top-8">
    <div class="mb-6 flex items-center gap-4">
      {portrait && (
        <Picture
          src={portrait}
          alt={portraitAlt}
          formats={["avif"]}
          fallbackFormat="webp"
          width={160}
          height={160}
          widths={[64, 80, 128, 160]}
          sizes="(min-width: 640px) 80px, 64px"
          quality={75}
          fit="cover"
          position="top"
          loading="lazy"
          decoding="async"
          pictureAttributes={{ class: "block shrink-0" }}
          class="block size-16 rounded-full border border-mint object-cover object-top sm:size-20"
        />
      )}
      <div>
        <p class="text-lg font-medium tracking-tight text-emerald-dark sm:text-xl">Cheima kochbati</p>
        <p class="mt-1 text-xs leading-relaxed tracking-[0.08em] text-emerald uppercase">Fondatrice de GlowLink</p>
      </div>
    </div>
    <h2 id="founder-heading" class="founder-heading text-4xl leading-[1.12] tracking-tight text-emerald-dark sm:text-5xl">
      Une expertise internationale. Un accompagnement profondément humain.
    </h2>
  </header>

  <div class="min-w-0">
    <div class="founder-timeline relative min-w-0">
      <div class="founder-rail" aria-hidden="true">
        <span class="founder-progress"></span>
      </div>
      <ol class="relative">
        {chapters.map(({ location, title, description }, index) => (
          <li class="founder-chapter relative pb-10 pl-8 last:pb-0 sm:pb-12 sm:pl-10">
            <span aria-hidden="true" class="founder-dot"></span>
            <details open class="group">
              <summary class="founder-summary cursor-pointer list-none text-emerald-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald">
                <h3 class="flex items-start justify-between gap-4">
                  <span class="min-w-0">
                    <span class="mb-3 block text-xs leading-relaxed font-medium tracking-[0.06em] text-emerald uppercase">
                      {String(index + 1).padStart(2, "0")} / {location}
                    </span>
                    <span class="block text-xl leading-snug font-medium tracking-tight sm:text-2xl">{title}</span>
                  </span>
                  <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" class="mt-1 size-5 shrink-0 group-open:rotate-180 motion-safe:transition-transform">
                    <path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </h3>
              </summary>
              <p class="mt-4 max-w-prose text-sm leading-relaxed text-midnight/90 sm:text-base">
                {description}
              </p>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .founder-heading {
    font-family: "Palatino Linotype", "Book Antiqua", Palatino, Georgia, serif;
  }

  .founder-summary::-webkit-details-marker {
    display: none;
  }

  .founder-rail {
    position: absolute;
    top: 0.5rem;
    bottom: 0;
    left: 0.25rem;
    width: 1px;
    overflow: hidden;
    background: var(--color-mint);
  }

  .founder-progress {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-emerald);
    transform-origin: top;
  }

  .founder-dot {
    position: absolute;
    top: 0.3rem;
    left: 0;
    width: 0.5625rem;
    height: 0.5625rem;
    border: 1px solid var(--color-emerald);
    border-radius: 50%;
    background: white;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .founder-timeline {
        view-timeline-name: --founder-reading;
        view-timeline-axis: block;
      }

      .founder-progress {
        animation: founder-progress 1s linear both;
        animation-timeline: --founder-reading;
        animation-range: entry 20% exit 50%;
      }

      @keyframes founder-progress {
        from { transform: scaleY(0); }
        to { transform: scaleY(1); }
      }

    }
  }
</style>
