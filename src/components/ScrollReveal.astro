<script>
  const sections = [...document.querySelectorAll<HTMLElement>("main > section:not(.video-hero)")];

  if (sections.length && "IntersectionObserver" in window) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let observer: IntersectionObserver | null = null;

    const reveal = (section: HTMLElement) => {
      section.dataset.sectionReveal = "visible";
      observer?.unobserve(section);
    };

    const update = () => {
      observer?.disconnect();

      if (reducedMotion.matches) {
        sections.forEach((section) => section.removeAttribute("data-section-reveal"));
        return;
      }

      observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) reveal(entry.target as HTMLElement);
        });
      }, { rootMargin: "0px 0px -32px 0px", threshold: 0 });

      sections.forEach((section) => {
        if (section.dataset.sectionReveal === "visible") return;

        // Keep the initial viewport and restored scroll positions immediately readable.
        if (section.getBoundingClientRect().top <= window.innerHeight) {
          reveal(section);
        } else {
          section.dataset.sectionReveal = "pending";
          observer?.observe(section);
        }
      });
    };

    document.addEventListener("focusin", (event) => {
      if (!(event.target instanceof Element)) return;
      const section = event.target.closest<HTMLElement>("[data-section-reveal='pending']");
      if (section) reveal(section);
    });

    update();
    reducedMotion.addEventListener("change", update);
  }
</script>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    [data-section-reveal="pending"] {
      opacity: 0;
      transform: translate3d(0, 24px, 0);
    }

    [data-section-reveal="visible"] {
      opacity: 1;
      transform: none;
      transition: opacity 650ms ease-out, transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-section-reveal]:focus-within {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
