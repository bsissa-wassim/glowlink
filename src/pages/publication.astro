---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLanguage, createTranslator, localizedHref } from "../lib/i18n";

export const prerender = false;
const lang = getLanguage(Astro);
const t = createTranslator(lang);

const sections = [
  { label: "Blog", href: "/blog" },
  { label: t("Parcours patient", "Patient journey"), href: "/experience-centree-patient" },
];
---

<BaseLayout lang={lang} title={t("Publication", "Publications")}>
  <nav aria-label={t("Rubriques Publication", "Publication categories")} class="mt-8">
    <ul class="flex flex-col gap-4 sm:flex-row sm:gap-10">
      {sections.map(({ label, href }) => (
        <li>
          <a href={localizedHref(href, lang)} class="inline-flex min-h-11 items-center gap-4 text-lg font-medium text-midnight hover:text-emerald motion-safe:transition-colors">
            {label}
            <span aria-hidden="true" class="text-emerald">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</BaseLayout>
