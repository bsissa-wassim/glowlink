---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CareIcon from "../components/CareIcon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { conceptContent } from "../data/conceptContent";
import { getLanguage, createTranslator, localizedHref } from "../lib/i18n";
import clinical from "../assets/specialties/concept-clinical.webp";
import wellness from "../assets/wellness/concept-relaxation.webp";

export const prerender = false;
const lang = getLanguage(Astro);
const t = createTranslator(lang);
const copy = conceptContent[lang];
const pillarIcons = ["shield", "brain", "leaf"] as const;
const locationIcons = ["globe", "clinic", "leaf"] as const;
const entrances = ["slide-left", "fade-up-scale", "slide-right"] as const;
---

<BaseLayout title={copy.pageTitle} hero lang={lang}>
  <Fragment slot="head">
    <meta name="description" content={copy.hero.text} />
    <link rel="alternate" hreflang="fr" href={new URL("/notre-concept?lang=fr", Astro.url).href} />
    <link rel="alternate" hreflang="en" href={new URL("/notre-concept?lang=en", Astro.url).href} />
  </Fragment>

  <section aria-labelledby="concept-heading" class="relative isolate overflow-hidden bg-sky py-14 text-midnight sm:py-20">
    <div class="concept-container grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
      <div>
        <p class="inline-block rounded-full border border-midnight/20 bg-white/40 px-4 py-2 text-sm font-medium leading-relaxed text-midnight">{copy.hero.badge}</p>
        <h1 id="concept-heading" class="mt-6 text-4xl leading-[1.12] tracking-tight sm:text-5xl xl:text-6xl">{copy.hero.title}</h1>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-midnight/85 sm:text-xl">{copy.hero.text}</p>
      </div>
      <div class="grid grid-cols-2 gap-3 sm:gap-5">
        <Picture src={clinical} alt={t("Une soignante à l’écoute d’une patiente dans un cabinet lumineux", "A healthcare professional listening to a patient in a bright consultation room")} formats={["avif"]} fallbackFormat="webp" widths={[320, 480, 640]} sizes="(min-width: 1024px) 20vw, 45vw" loading="eager" fetchpriority="high" pictureAttributes={{ class: "block overflow-hidden rounded-2xl" }} class="aspect-[3/5] h-full w-full object-cover object-[35%_center]" />
        <Picture src={wellness} alt={t("Massage relaxant dans un espace bien-être face à la Méditerranée", "A relaxing massage in a wellness suite overlooking the Mediterranean")} formats={["avif"]} fallbackFormat="webp" widths={[320, 480, 640]} sizes="(min-width: 1024px) 20vw, 45vw" loading="eager" pictureAttributes={{ class: "mt-8 block overflow-hidden rounded-2xl" }} class="aspect-[3/5] h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <section aria-labelledby="identity-heading" class="bg-white py-14 sm:py-20">
    <div class="concept-container">
      <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-14">
        <div>
          <SectionHeading id="identity-heading" title={copy.about.title} tone="midnight" />
          <p class="mt-7 text-lg leading-relaxed text-midnight/85">{copy.about.text}</p>
        </div>
        <div class="rounded-[20px] border border-sage/50 bg-white p-6 sm:p-8">
          <ul class="divide-y divide-sage/30">
            {copy.about.locations.map((location, index) => (
              <li class="flex gap-4 py-6 first:pt-0 last:pb-0">
                <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-sky/25 text-emerald"><CareIcon name={locationIcons[index]} class="size-6" /></span>
                <div>
                  <h3 class="text-xl leading-snug text-midnight">{location.title}</h3>
                  <p class="mt-3 text-base leading-relaxed text-midnight/80">{location.text}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <aside aria-label={t("Note importante", "Important note")} class="mt-10 flex gap-4 rounded-2xl border-l-4 border-sage bg-sky/15 p-6 sm:p-8">
        <CareIcon name="briefcase" class="mt-1 size-6 shrink-0 text-emerald" />
        <p class="text-base leading-relaxed text-midnight/85 sm:text-lg">{copy.about.note}</p>
      </aside>
    </div>
  </section>

  <section data-reveal-children aria-labelledby="concept-pillars-heading" class="bg-white pb-14 sm:pb-20">
    <div class="concept-container">
      <SectionHeading id="concept-pillars-heading" title={copy.pillarsTitle} tone="midnight" centered />
      <div data-stagger-reveal data-reveal-stagger="140" class="mt-10 grid gap-6 lg:grid-cols-3">
        {copy.pillars.map((pillar, index) => (
          <article data-reveal-item data-reveal-effect={entrances[index]} class="rounded-[20px] border border-sage/30 bg-white p-7 sm:p-8">
            <span class="flex size-16 items-center justify-center rounded-full bg-emerald text-white"><CareIcon name={pillarIcons[index]} class="size-8" /></span>
            <h3 class="mt-6 text-2xl leading-snug text-midnight">{pillar.title}</h3>
            <p class="mt-5 text-lg leading-relaxed text-midnight/80">{pillar.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="parcours-zero-stress" data-reveal-children aria-labelledby="concept-journey-heading" class="scroll-mt-8 bg-sky/15 py-14 sm:py-20">
    <div class="concept-container">
      <SectionHeading id="concept-journey-heading" title={copy.journeyTitle} tone="midnight" centered />
      <ol data-stagger-reveal data-reveal-stagger="160" class="concept-timeline relative mx-auto mt-12 max-w-4xl space-y-6">
        {copy.steps.map((step, index) => (
          <li data-reveal-item data-reveal-effect="slide-left" class="relative pl-16 sm:pl-24">
            <span aria-hidden="true" class="absolute left-0 top-5 z-10 flex size-12 items-center justify-center rounded-full bg-champagne text-lg font-bold text-midnight sm:left-2 sm:size-14">{String(index + 1).padStart(2, "0")}</span>
            <details open={index === 0} class="group rounded-2xl border border-sage/30 bg-white">
              <summary class="flex min-h-24 cursor-pointer list-none items-center justify-between gap-4 rounded-2xl p-5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald sm:p-7 [&::-webkit-details-marker]:hidden">
                <h3 class="text-lg leading-snug text-midnight sm:text-xl">{step.title}</h3>
                <span aria-hidden="true" class="relative size-5 shrink-0 text-emerald"><span class="absolute left-0 top-1/2 h-0.5 w-5 bg-current"></span><span class="absolute left-1/2 top-0 h-5 w-0.5 bg-current group-open:hidden"></span></span>
              </summary>
              <p class="border-t border-sage/20 px-5 py-6 text-lg leading-relaxed text-midnight/80 sm:px-7">{step.text}</p>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="faq" data-reveal-children aria-labelledby="concept-faq-heading" class="scroll-mt-8 bg-white py-14 sm:py-20">
    <div class="concept-container">
      <SectionHeading id="concept-faq-heading" title={copy.faqTitle} tone="midnight" centered />
      <div data-stagger-reveal data-reveal-stagger="120" class="mx-auto mt-10 max-w-4xl divide-y divide-sage/40 border-y border-sage/40">
        {copy.faqs.map((faq) => (
          <details data-reveal-item data-reveal-effect="fade-up-scale" class="group">
            <summary class="flex min-h-20 cursor-pointer list-none items-center justify-between gap-6 py-6 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald [&::-webkit-details-marker]:hidden">
              <h3 class="text-lg leading-snug text-midnight sm:text-xl">{faq.question}</h3>
              <span aria-hidden="true" class="relative size-5 shrink-0 text-emerald"><span class="absolute left-0 top-1/2 h-0.5 w-5 bg-current"></span><span class="absolute left-1/2 top-0 h-5 w-0.5 bg-current group-open:hidden"></span></span>
            </summary>
            <p class="pb-7 pr-6 text-lg leading-relaxed text-midnight/80 sm:pr-12">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="concept-assessment-heading" class="bg-midnight py-16 text-center text-white sm:py-20">
    <div class="concept-container">
      <h2 id="concept-assessment-heading" class="mx-auto max-w-4xl text-3xl leading-tight tracking-tight sm:text-5xl">{copy.cta.title}</h2>
      <a href={localizedHref("/#contact", lang)} class="mt-9 inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-emerald px-7 py-4 text-lg font-semibold text-white hover:bg-emerald/80 focus-visible:outline-sky motion-safe:transition-colors">{copy.cta.button}<span aria-hidden="true">→</span></a>
    </div>
  </section>
  <ScrollReveal />
</BaseLayout>

<style>
  .concept-container { width: 100%; max-width: 80rem; margin-inline: auto; padding-inline: clamp(1rem, 3vw, 3rem); }
  h1, h2, h3 { text-wrap: balance; }
  .concept-timeline::before { content: ""; position: absolute; top: 2rem; bottom: 2rem; left: 1.5rem; width: 1px; background: var(--color-sage); }
  @media (min-width: 40rem) { .concept-timeline::before { left: 2.25rem; } }
</style>
