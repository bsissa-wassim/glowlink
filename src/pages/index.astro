---
import BaseLayout from "../layouts/BaseLayout.astro";
import VideoHero from "../components/VideoHero.astro";
import ContactSection from "../components/ContactSection.astro";
import SocialMarquee from "../components/SocialMarquee.astro";
import founderPortrait from "../assets/fondatrice.jpeg";
import MedicalNetwork from "../components/MedicalNetwork.astro";
import HolisticApproach from "../components/HolisticApproach.astro";
import PatientJourney from "../components/PatientJourney.astro";
import CareSpecialties from "../components/CareSpecialties.astro";
import AboutMission from "../components/AboutMission.astro";
import OffersSection from "../components/OffersSection.astro";
import PublicationsSection from "../components/PublicationsSection.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import FloatingOffers from "../components/FloatingOffers.astro";
import OffersBanner from "../components/OffersBanner.astro";
import { getHomepageContent } from "../data/homepageContent";
import { getLanguage, createTranslator } from "../lib/i18n";

export const prerender = false;
const lang = getLanguage(Astro);
const t = createTranslator(lang);
const homepageContent = getHomepageContent(lang);
---

<BaseLayout title={t("Accueil", "Home")} hero lang={lang}>
  <nav slot="navigation" aria-label={t("Choisir la langue", "Choose language")} class="flex justify-center gap-1 lg:justify-self-end">
    {(["fr", "en"] as const).map((language) => (
      <a href={`/?lang=${language}`} lang={language} hreflang={language} aria-current={language === lang ? "true" : undefined} class:list={["flex min-h-11 min-w-11 items-center justify-center rounded-full text-sm font-semibold focus-visible:outline-sky", language === lang ? "bg-sky text-midnight" : "text-white hover:bg-white/10"]}>{language.toUpperCase()}</a>
    ))}
  </nav>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    href="/media/massage-poster.webp"
    fetchpriority="high"
  />
  <VideoHero
    title={homepageContent.hero.title}
    description={homepageContent.hero.description}
  >
    <Fragment slot="actions">
      <a
        href="#contact"
        class="inline-flex min-h-11 items-center justify-center rounded-full bg-midnight px-5 py-3 text-sm font-semibold text-white hover:bg-midnight/90 focus-visible:outline-white motion-safe:transition-colors"
      >
        {t("Obtenir un devis gratuit", "Get a free quote")}
      </a>
      <a
        href="#parcours-patient"
        class="inline-flex min-h-11 items-center text-sm font-medium text-white underline decoration-white/50 underline-offset-4 hover:decoration-white focus-visible:outline-white motion-safe:transition-colors"
      >
        {t("Découvrir l’expérience", "Discover the experience")}
      </a>
    </Fragment>
  </VideoHero>
  <HolisticApproach />
  <PatientJourney />
  <OffersBanner />
  <CareSpecialties />
  <AboutMission portrait={founderPortrait} />
  <MedicalNetwork />
  <OffersSection />
  <PublicationsSection />
  <ContactSection />
  <SocialMarquee />
  <ScrollReveal />
  <FloatingOffers slot="overlay" />
</BaseLayout>
